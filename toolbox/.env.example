# OpenTofu will pull these from the container's environment into infra/proxmox's
# variables. Copy this file to .env (gitignored) and fill in real values.
# This is an alternative to infra/proxmox/terraform.tfvars, not required alongside it -
# pick one. terraform.tfvars wins if the same variable is set in both places.

# No trailing slash
TF_VAR_proxmox_endpoint="https://{your.proxmox.server}:8006"
TF_VAR_proxmox_api_token="{user}@pve!{token}={your-token-string}"
TF_VAR_node_name="{your-proxmox-node-name}"
TF_VAR_proxmox_insecure=true  # only if using a self-signed cert without importing it

TF_VAR_ssh_public_keys='["ssh-ed25519 AAAA... you@yourmachine"]'

TF_VAR_gateway_ip="192.168.1.1"
TF_VAR_dns_server="192.168.1.1"

TF_VAR_control_plane_ip_cidr="192.168.1.11/24"
TF_VAR_worker_ip_cidr="192.168.1.12/24"
TF_VAR_storage_ip_cidr="192.168.1.13/24"

# Static IP(s) MetalLB is allowed to hand out to LoadBalancer services (see k8s/metallb).
# Must be outside your router's DHCP range and not overlap the node IPs above.
# Accepts anything MetalLB's IPAddressPool.spec.addresses supports: a single host CIDR
# (/32), a larger CIDR block, or a "start-end" range.
METALLB_ADDRESS_POOL_CIDR="192.168.1.200/32"

# metallb/metallb chart version to install (see k8s/metallb/README.md) - check
# https://github.com/metallb/metallb/releases for the current one
METALLB_CHART_VERSION="0.16.2"

# Only needed if 9000 is already taken on your node - check with `qm status 9000`
# TF_VAR_template_vm_id=9005

# Baked into the Packer image. Don't go below 1.32. v1.32 onwards were
# re-signed with v4 packets
KUBERNETES_VERSION="1.37"

# https://github.com/containerd/containerd/releases,
# https://github.com/opencontainers/runc/releases
# https://github.com/containernetworking/plugins/releases
CONTAINERD_VERSION="2.4.2"
RUNC_VERSION="1.5.2"
CNI_PLUGINS_VERSION="1.10.0"

# Envoy TLS gateway API. There's no GATEWAY_API_VERSION here on purpose - the
# gateway-helm chart installs the Gateway API CRDs itself (experimental channel)
# See k8s/envoy-gateway/README.md.
ENVOY_GATEWAY_CHART_VERSION="1.10.0"
ENVOY_GATEWAY_NAMESPACE="envoy-gateway-system"

# Used to hold the admin key pair generated by scripts/generate-keys.sh
KEY_DIR=/work/keys
DEPLOY_PRIVATE_KEY_PATH=$KEY_DIR/admin/admin-ed25519
DEPLOY_PUBLIC_KEY_PATH=$KEY_DIR/admin/admin-ed25519.pub

# admin.conf is fetched here by ansible/playbooks/k8s-init/main.yml - kubectl has no
# default lookup path inside the container without this
KUBECONFIG=/work/.kube/config
