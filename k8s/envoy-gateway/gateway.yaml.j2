---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: web-gateway
  namespace: "{{ lookup( 'env', 'ENVOY_GATEWAY_NAMESPACE') }}"
spec:
  gatewayClassName: envoy
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          # default is from: Same, so go with from: All for now to get around this
          # TODO: Switch this to the nginx
          from: All